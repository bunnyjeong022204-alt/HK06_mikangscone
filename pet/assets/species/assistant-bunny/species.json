{
  "id": "assistant-bunny",
  "displayName": "토비서",
  "version": "1.0.0",
  "animations": {
    "idle": {
      "sheet": "sprite.svg",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 1,
      "fps": 2,
      "loop": true,
      "motion": "breathe"
    },
    "walk": {
      "sheet": "sprite.svg",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 1,
      "fps": 2,
      "loop": true,
      "motion": "bounce",
      "mirrorWhen": "left"
    },
    "sleep": {
      "sheet": "sprite.svg",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 1,
      "fps": 2,
      "loop": true,
      "motion": "sleep",
      "effect": "sleep"
    },
    "dragged": {
      "sheet": "sprite.svg",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 1,
      "fps": 2,
      "loop": true,
      "motion": "wriggle",
      "authoredGrip": true
    }
  },
  "behavior": {
    "personality": "curious",
    "walkSpeedPxPerSec": 53,
    "idleMinMs": 1800,
    "idleMaxMs": 3900,
    "walkMinMs": 4200,
    "walkMaxMs": 8200,
    "spriteScale": 0.56
  },
  "attribution": {
    "author": "미깡스콘 캐릭터",
    "license": "Original artwork drawn for this project"
  }
}
