{
  "id": "mono-cat",
  "displayName": "까망이",
  "version": "1.0.0",
  "animations": {
    "idle": {
      "sheet": "sprites/idle.png",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 6,
      "fps": 5,
      "loop": true
    },
    "walk": {
      "sheet": "sprites/walk-right.png",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 10,
      "fps": 12,
      "loop": true,
      "mirrorWhen": "left"
    },
    "sleep": {
      "sheet": "sprites/sleep.png",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 4,
      "fps": 3,
      "loop": true
    },
    "dragged": {
      "sheet": "sprites/dragged.png",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 8,
      "fps": 14,
      "loop": true,
      "authoredGrip": true
    },
    "react": {
      "sheet": "sprites/react.png",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 4,
      "fps": 10,
      "loop": false
    }
  },
  "motions": {
    "frontWalk": {
      "sheet": "sprites/frontWalk.png",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 10,
      "fps": 12,
      "loop": true
    },
    "backWalk": {
      "sheet": "sprites/backWalk.png",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 10,
      "fps": 12,
      "loop": true
    },
    "look": {
      "sheet": "sprites/look.png",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 1,
      "fps": 1,
      "loop": true,
      "mirrorWhen": "left"
    },
    "jump": {
      "sheet": "sprites/jump.png",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 4,
      "fps": 12,
      "loop": false,
      "mirrorWhen": "left"
    },
    "land": {
      "sheet": "sprites/land.png",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 7,
      "fps": 23,
      "loop": false,
      "mirrorWhen": "left"
    },
    "fly": {
      "sheet": "sprites/fly.png",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 8,
      "fps": 12,
      "loop": true,
      "mirrorWhen": "left"
    },
    "climb": {
      "sheet": "sprites/climb.png",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 8,
      "fps": 10,
      "loop": true,
      "mirrorWhen": "right",
      "wallInsets": {
        "left": 0,
        "right": 20
      }
    },
    "wallIdle": {
      "sheet": "sprites/wall-idle.png",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 4,
      "fps": 5,
      "loop": true,
      "mirrorWhen": "right",
      "wallInsets": {
        "left": 0,
        "right": 20
      }
    },
    "wallImpact": {
      "sheet": "sprites/wall-impact.png",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 4,
      "fps": 22,
      "loop": false,
      "mirrorWhen": "right"
    },
    "wallFall": {
      "sheet": "sprites/wall-fall.png",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 8,
      "fps": 12,
      "loop": true,
      "mirrorWhen": "right"
    },
    "scratch": {
      "sheet": "sprites/scratch.png",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 8,
      "fps": 18,
      "loop": false,
      "mirrorWhen": "left"
    },
    "landPrepare": {
      "sheet": "sprites/land-prepare.png",
      "frameWidth": 192,
      "frameHeight": 192,
      "frameCount": 4,
      "fps": 35,
      "loop": false,
      "mirrorWhen": "left"
    }
  },
  "behavior": {
    "doubleClick": "chase",
    "sideWalkInsets": {
      "left": 20,
      "right": 20
    },
    "sideWalkDepth": 0.16,
    "walkSpeedPxPerSec": 64,
    "idleMinMs": 1600,
    "idleMaxMs": 3300,
    "walkMinMs": 3800,
    "walkMaxMs": 7200,
    "spriteScale": 0.625,
    "personality": "curious",
    "alwaysLandOnFeet": true
  },
  "attribution": {
    "author": "사용자 제공 이미지",
