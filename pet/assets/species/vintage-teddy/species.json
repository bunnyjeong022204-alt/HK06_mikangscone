  "behavior": {
    "doubleClick": "hearts",
    "sideWalkInsets": { "left": 50, "right": 51 },
    "sideWalkDepth": 0.16,
    "walkSpeedPxPerSec": 47,
    "idleMinMs": 1800,
    "idleMaxMs": 4100,
    "walkMinMs": 4100,
    "walkMaxMs": 7600,
    "spriteScale": 0.583,
    "personality": "relaxed"
  },
  "attribution": {
    "author": "빈티지 크래프트 테마",
